{
  "appId": "com.elmubarak.digitalhub",
  "appName": "Elmubarak Digital Hub",
  "webDir": "www",
  "backgroundColor": "#1B2A42",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "*.elmubarak.example",
      "REPLACE-WITH-YOUR-WEB-APP-DOMAIN"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "backgroundColor": "#1B2A42",
      "androidSplashResourceName": "splash",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#1B2A42"
    }
  }
}
